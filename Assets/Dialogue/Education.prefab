  m_Text: "\u041F\u0440\u0430\u0432\u0438\u043B\u0430:\n\u0412\u044B \u0438\u0433\u0440\u0430\u0435\u0442\u0435
    \u0437\u0430 \u043A\u043E\u043D\u044F.\n\u0426\u0435\u043B\u044C - \u0434\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F
    \u0434\u043E \u043D\u0430\u0433\u0440\u0430\u0434\u044B.\n\u0415\u0441\u043B\u0438
    \u043D\u0430\u0441\u0442\u0443\u043F\u0438\u0442\u0435 \u043D\u0430 \u0434\u0440\u0443\u0433\u0443\u044E
    \u0444\u0438\u0433\u0443\u0440\u0443, \u0442\u043E \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0435
    \u0441\u043D\u0430\u0447\u0430\u043B\u0430.\n\u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435:\n\u041D\u0430\u0436\u0438\u043C\u0430\u0439\u0442\u0435
    \u0446\u0438\u0444\u0440\u044B 1-8 \u043D\u0430 \u043A\u043B\u0430\u0432\u0438\u0430\u0442\u0443\u0440\u0435:\n1
    - \u043E\u0434\u043D\u0430 \u043A\u043B\u0435\u0442\u043A\u0430 \u0432\u043F\u0440\u0430\u0432\u043E
    \u0438 \u0434\u0432\u0435 \u0432\u0432\u0435\u0440\u0445.\n2 - \u0434\u0432\u0435
    \u043A\u043B\u0435\u0442\u043A\u0438 \u0432\u043F\u0440\u0430\u0432\u043E \u0438
    \u043E\u0434\u043D\u0430 \u0432\u0432\u0435\u0440\u0445.\n3 - \u043E\u0434\u043D\u0430
    \u043A\u043B\u0435\u0442\u043A\u0430 \u0432\u043B\u0435\u0432\u043E \u0438 \u0434\u0432\u0435
    \u0432\u0432\u0435\u0440\u0445.\n4 - \u0434\u0432\u0435 \u043A\u043B\u0435\u0442\u043A\u0438
    \u0432\u043B\u0435\u0432\u043E \u0438 \u043E\u0434\u043D\u0430 \u0432\u0432\u0435\u0440\u0445.\n5
    - \u043E\u0434\u043D\u0430 \u043A\u043B\u0435\u0442\u043A\u0430 \u0432\u043F\u0440\u0430\u0432\u043E
    \u0438 \u0434\u0432\u0435 \u0432\u043D\u0438\u0437.\n6 - \u0434\u0432\u0435 \u043A\u043B\u0435\u0442\u043A\u0438
    \u0432\u043F\u0440\u0430\u0432\u043E \u0438 \u043E\u0434\u043D\u0430 \u0432\u043D\u0438\u0437.\n7
    - \u043E\u0434\u043D\u0430 \u043A\u043B\u0435\u0442\u043A\u0430 \u0432\u043B\u0435\u0432\u043E
    \u0438 \u0434\u0432\u0435 \u0432\u043D\u0438\u0437.\n8 - \u0434\u0432\u0435 \u043A\u043B\u0435\u0442\u043A\u0438
    \u0432\u043B\u0435\u0432\u043E \u0438 \u043E\u0434\u043D\u0430 \u0432\u043D\u0438\u0437."
